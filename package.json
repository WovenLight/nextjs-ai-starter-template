{
  "name": "nextjs-ai-starter-template",
  "version": "0.1.0",
  "private": true,
  "description": "A modern Next.js starter template with AI integration, authentication, and TypeScript",
  "keywords": [
    "nextjs",
    "typescript",
    "ai",
    "copilotkit",
    "mastra",
    "stack-auth",
    "neon",
    "drizzle"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/WovenLight/nextjs-ai-starter-template.git"
  },
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:agent": "node -r dotenv/config ./node_modules/.bin/mastra dev",
    "dev:ui": "next dev --turbopack",
    "dev:debug": "LOG_LEVEL=debug pnpm run dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "pretty": "prettier --write \"./**/*.{ts,tsx}\"",
    "setup:auth": "pnpm dlx @stackframe/init-stack@latest",
    "setup:env": "cp .env.local.example .env.local",
    "setup": "pnpm install && pnpm run setup:env && pnpm run setup:auth",
    "clean": "rm -rf .next node_modules pnpm-lock.yaml && pnpm install",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@ag-ui/mastra": "^0.0.4",
    "@ai-sdk/openai": "^1.3.22",
    "@copilotkit/react-core": "1.9.3",
    "@copilotkit/react-ui": "1.9.3",
    "@copilotkit/runtime": "1.9.3",
    "@heroui/react": "2.8.1",
    "@libsql/client": "^0.15.10",
    "@mastra/client-js": "0.10.9",
    "@mastra/core": "0.10.15",
    "@mastra/libsql": "^0.11.0",
    "@mastra/memory": "^0.11.1",
    "@neondatabase/serverless": "^1.0.1",
    "@stackframe/stack": "2.7.6",
    "@tailwindcss/postcss": "^4",
    "ai": "4.3.19",
    "drizzle-kit": "0.31.4",
    "drizzle-orm": "0.44.3",
    "framer-motion": "12.23.9",
    "libsql": "^0.5.13",
    "mastra": "0.10.10",
    "next": ">=15.3.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "10.1.0",
    "tailwindcss": "^4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.1.2",
    "dotenv": "17.2.0",
    "eslint": "^9",
    "eslint-config-next": "15.3.2",
    "prettier": "^3.6.2",
    "typescript": "^5.8.3"
  }
}
