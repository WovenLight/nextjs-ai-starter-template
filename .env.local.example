# Database
DATABASE_URL=postgresql://user:password@hostname:port/database_name

# Stack Auth Configuration
# Get these values from: https://stack-auth.com/
NEXT_PUBLIC_STACK_PROJECT_ID=your_project_id_here
NEXT_PUBLIC_STACK_PUBLISHABLE_CLIENT_KEY=your_publishable_key_here
STACK_SECRET_SERVER_KEY=your_secret_key_here

# Optional: Custom Stack Auth API URL (defaults to https://api.stack-auth.com)
# NEXT_PUBLIC_STACK_API_URL=https://api.stack-auth.com

# OpenAI Configuration
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Development Settings
# Set these to true for local development to bypass authentication
BYPASS_AUTH=true
NEXT_PUBLIC_BYPASS_AUTH=true

# Optional: Mastra Agent Configuration
# MASTRA_AGENT_URL=http://localhost:4000

# Optional: Encryption key for sensitive data
# ENCRYPTION_KEY=your_encryption_key_here

# Optional: Log level for debugging
# LOG_LEVEL=debug